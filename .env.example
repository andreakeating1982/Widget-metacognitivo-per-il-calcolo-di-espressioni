# WIDGET METACOGNITIVO PER IL CALCOLO DI ESPRESSIONI
# Modello privo di credenziali. Non pubblicare il proprio file .env.
# Avvio reale: pnpm build && pnpm start. Vite dev non serve /api/*.
NODE_ENV=production
PORT=3000

# Chiave personale per le funzioni IA, SOLO server/build (mai VITE_*).
# In ambiente Render impostarla nella sezione Environment.
# La build senza chiave riesce; le funzioni IA rispondono 503.
EASY_PEASY_API_KEY=

# Facoltativo: persistenza cache/sessioni. Senza, file temporanei.
# Non copiare il database di produzione per collaudare il pacchetto.
DATABASE_URL=
